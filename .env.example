#----------------------------------------------------------
# Supabase Environment Variables
#----------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

#----------------------------------------------------------
# Google OAuth (optional, for Supabase Auth)
#   Get these from https://console.cloud.google.com/apis/credentials
#----------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

#----------------------------------------------------------
# App origin (server-side only, used by the OAuth sign-in action)
#----------------------------------------------------------
SITE_URL=http://localhost:3000

#----------------------------------------------------------
# SAA 2025 event target (server-side only)
#----------------------------------------------------------
# ISO-8601 event start date/time; drives the homepage countdown target.
EVENT_DATETIME=2026-12-26T18:30:00+07:00
